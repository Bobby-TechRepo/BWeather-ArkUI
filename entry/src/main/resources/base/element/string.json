    {
      "name": "privacyIntro",
      "value": "BWeather has no accounts, no ads and no analytics. This page explains which data leaves your device and why."
    },
    {
      "name": "privacyLocationTitle",
      "value": "Your location"
    },
    {
      "name": "privacyLocationBody",
      "value": "If you allow it, the app reads your device's location. The coordinates are sent to Open-Meteo to get the forecast and to OpenStreetMap Nominatim to get the name of the place. They are not sent anywhere else."
    },
    {
      "name": "privacyApproximateTitle",
      "value": "Approximate location"
    },
    {
      "name": "privacyApproximateBody",
      "value": "When precise location isn't available, the app asks ipapi.co for an approximate, city-level location. ipapi.co sees your IP address to answer this request."
    },
    {
      "name": "privacySearchTitle",
      "value": "City search"
    },
    {
      "name": "privacySearchBody",
      "value": "The text you type in the city search is sent to Open-Meteo's geocoding service to find matching places."
    },
    {
